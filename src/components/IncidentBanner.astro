---
import type { Incident } from '../lib/incidents';

interface Props {
  incidents: Incident[];
}

const { incidents } = Astro.props;
const active = incidents.filter((i) => !i.resolved);
---

{active.length > 0 && (
  <section class="incidents">
    <h2>Incidentes activos</h2>
    {active.map((incident) => (
      <article class={`incident incident--${incident.severity.toLowerCase()}`}>
        <header>
          <span class="severity">{incident.severity}</span>
          <h3>{incident.title}</h3>
          <time datetime={incident.started}>
            Comenzó {new Date(incident.started).toLocaleString('es-CO', { dateStyle: 'short', timeStyle: 'short' })}
          </time>
        </header>
        <p class="services">
          Afecta: {incident.services.join(', ')}
        </p>
        <details>
          <summary>Ver detalle</summary>
          <pre class="body">{incident.body}</pre>
        </details>
      </article>
    ))}
  </section>
)}

<style>
  .incidents {
    margin: 0 0 2rem;
  }
  .incidents > h2 {
    font-family: var(--font-display, 'Editorial New', serif);
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }
  .incident {
    background: var(--surface-raised, #10172A);
    border: 1px solid #EF4444;
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
  }
  .incident--p3 { border-color: #FFB347; }
  .incident--p4 { border-color: rgba(232, 241, 255, 0.24); }
  .incident header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .severity {
    background: #EF4444;
    color: #0A0F1E;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    letter-spacing: 0.04em;
  }
  .incident--p3 .severity { background: #FFB347; }
  .incident--p4 .severity { background: rgba(232, 241, 255, 0.48); }
  h3 {
    font-size: 1.125rem;
    margin: 0;
  }
  time {
    font-size: 0.75rem;
    color: var(--text-muted, rgba(232, 241, 255, 0.48));
    font-feature-settings: 'tnum';
  }
  .services {
    font-size: 0.875rem;
    color: var(--text-secondary, rgba(232, 241, 255, 0.72));
    margin: 0.5rem 0 0;
  }
  details {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }
  summary { cursor: pointer; color: var(--color-ember, #FF6B35); }
  .body {
    margin: 0.5rem 0 0;
    white-space: pre-wrap;
    font-family: inherit;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
</style>
