---
import type { ServiceConfig } from '../config';
import type { HealthCheckEntry } from '../lib/history';
import { currentStatusFor, uptimeForLastNDays } from '../lib/history';

interface Props {
  service: ServiceConfig;
  entries: HealthCheckEntry[];
}

const { service, entries } = Astro.props;
const status = currentStatusFor(entries);
const uptime90 = uptimeForLastNDays(entries, 90);
const uptime30 = uptimeForLastNDays(entries, 30);

const statusLabel: Record<string, string> = {
  operational: 'Operacional',
  degraded: 'Degradado',
  down: 'Caído',
  'no-data': 'Sin datos',
};
---

<article class={`service service--${status}`}>
  <div class="head">
    <div>
      <h3>{service.label}</h3>
      <p class="desc">{service.description}</p>
    </div>
    <span class="badge">{statusLabel[status]}</span>
  </div>
  <dl class="stats">
    <div>
      <dt>Uptime 30d</dt>
      <dd>{uptime30.toFixed(2)}%</dd>
    </div>
    <div>
      <dt>Uptime 90d</dt>
      <dd>{uptime90.toFixed(2)}%</dd>
    </div>
    <div>
      <dt>Severidad</dt>
      <dd>{service.severity}</dd>
    </div>
  </dl>
</article>

<style>
  .service {
    background: var(--surface-raised, #10172A);
    border: 1px solid var(--surface-border, rgba(232, 241, 255, 0.12));
    border-radius: 0.75rem;
    padding: 1.25rem;
    transition: border-color 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .service--down { border-color: #EF4444; }
  .service--degraded { border-color: #FFB347; }
  .service--operational:hover {
    border-color: rgba(232, 241, 255, 0.24);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  h3 {
    font-size: 1.125rem;
    margin: 0 0 0.25rem;
    color: var(--text-primary, #E8F1FF);
  }
  .desc {
    font-size: 0.875rem;
    color: var(--text-secondary, rgba(232, 241, 255, 0.72));
    margin: 0;
  }
  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: rgba(34, 197, 94, 0.15);
    color: #22C55E;
    flex-shrink: 0;
  }
  .service--down .badge { background: rgba(239, 68, 68, 0.15); color: #EF4444; }
  .service--degraded .badge { background: rgba(255, 179, 71, 0.15); color: #FFB347; }
  .service--no-data .badge { background: rgba(232, 241, 255, 0.08); color: rgba(232, 241, 255, 0.48); }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 1rem 0 0;
  }
  .stats div { display: flex; flex-direction: column; gap: 0.125rem; }
  dt {
    font-size: 0.6875rem;
    color: var(--text-muted, rgba(232, 241, 255, 0.48));
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  dd {
    font-size: 1rem;
    margin: 0;
    color: var(--text-primary, #E8F1FF);
    font-feature-settings: 'tnum';
  }
</style>
